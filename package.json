{
  "name": "pncat",
  "type": "module",
  "version": "0.11.0",
  "packageManager": "pnpm@10.32.1",
  "description": "A unified cli tool that enhances package managers catalogs feature.",
  "author": "jinghaihan",
  "license": "MIT",
  "homepage": "https://github.com/jinghaihan/pncat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jinghaihan/pncat.git"
  },
  "bugs": {
    "url": "https://github.com/jinghaihan/pncat/issues"
  },
  "keywords": [
    "pnpm",
    "yarn",
    "berry",
    "bun",
    "vlt",
    "catalog",
    "catalogs",
    "workspace"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./rules": "./dist/rules.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "pncat": "./bin/pncat.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "pncat": "tsx ./src/cli.ts",
    "build": "tsdown --config-loader unrun",
    "deps": "taze major -I",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "release": "bumpp",
    "bootstrap": "pnpm install",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "catalog:prod",
    "ansis": "catalog:prod",
    "cac": "catalog:prod",
    "find-up": "catalog:prod",
    "package-manager-detector": "catalog:prod",
    "pathe": "catalog:prod",
    "pnpm-workspace-yaml": "catalog:prod",
    "tinyexec": "catalog:prod",
    "tinyglobby": "catalog:prod",
    "unconfig": "catalog:prod"
  },
  "devDependencies": {
    "tsdown": "catalog:build",
    "bumpp": "catalog:dev",
    "nano-staged": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "taze": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "@antfu/utils": "catalog:inlined",
    "@npmcli/config": "catalog:inlined",
    "deepmerge": "catalog:inlined",
    "detect-indent": "catalog:inlined",
    "diff": "catalog:inlined",
    "fast-npm-meta": "catalog:inlined",
    "npm-package-arg": "catalog:inlined",
    "npm-registry-fetch": "catalog:inlined",
    "p-retry": "catalog:inlined",
    "semver-es": "catalog:inlined",
    "tildify": "catalog:inlined",
    "ufo": "catalog:inlined",
    "yaml": "catalog:inlined",
    "@octohash/eslint-config": "catalog:lint",
    "eslint": "catalog:lint",
    "@vitest/coverage-v8": "catalog:test",
    "vitest": "catalog:test",
    "@types/node": "catalog:types",
    "@types/npm-package-arg": "catalog:types",
    "@types/npm-registry-fetch": "catalog:types",
    "pncat": "workspace:*"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*": "eslint --fix"
  },
  "inlinedDependencies": {
    "diff": "8.0.3",
    "tildify": "3.0.0",
    "detect-indent": "7.0.2",
    "semver-es": "0.1.0",
    "is-network-error": "1.3.0",
    "p-retry": "7.1.1",
    "ufo": "1.6.3",
    "fast-npm-meta": "1.4.2",
    "walk-up-path": "4.0.0",
    "ini": [
      "5.0.0",
      "6.0.0"
    ],
    "abbrev": "4.0.0",
    "nopt": "9.0.0",
    "@npmcli/config": "10.7.1",
    "json-parse-even-better-errors": "4.0.0",
    "@npmcli/package-json": "7.0.1",
    "spdx-license-ids": "3.0.21",
    "spdx-exceptions": "2.5.0",
    "spdx-expression-parse": "3.0.1",
    "spdx-correct": "3.2.0",
    "validate-npm-package-license": "3.0.4",
    "isexe": "3.1.1",
    "which": "5.0.0",
    "@npmcli/promise-spawn": "8.0.3",
    "@npmcli/git": "7.0.0",
    "npm-install-checks": "7.1.2",
    "npm-normalize-package-bin": "4.0.0",
    "npm-pick-manifest": "11.0.1",
    "@npmcli/name-from-folder": "3.0.0",
    "@isaacs/brace-expansion": [
      "5.0.0",
      "5.0.1"
    ],
    "minimatch": [
      "10.0.3",
      "10.1.2"
    ],
    "@npmcli/map-workspaces": "5.0.0",
    "npm-registry-fetch": "19.1.1",
    "minizlib": "3.1.0",
    "minipass": [
      "3.3.6",
      "7.1.2"
    ],
    "minipass-sized": "1.0.3",
    "minipass-fetch": [
      "4.0.1",
      "5.0.0"
    ],
    "safer-buffer": "2.1.2",
    "iconv-lite": "0.6.3",
    "encoding": "0.1.13",
    "@npmcli/redact": "4.0.0",
    "make-fetch-happen": "15.0.2",
    "http-cache-semantics": "4.2.0",
    "negotiator": "1.0.0",
    "ssri": "12.0.0",
    "minipass-flush": "1.0.5",
    "minipass-collect": "2.0.1",
    "minipass-pipeline": "1.2.4",
    "imurmurhash": "0.1.4",
    "unique-slug": "5.0.0",
    "unique-filename": "4.0.0",
    "cacache": "20.0.1",
    "@npmcli/fs": "4.0.0",
    "fs-minipass": "3.0.3",
    "@npmcli/agent": "4.0.0",
    "ms": "2.1.3",
    "debug": "4.4.3",
    "has-flag": "4.0.0",
    "supports-color": "7.2.0",
    "agent-base": "7.1.4",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "smart-buffer": "4.2.0",
    "socks": "2.8.7",
    "ip-address": "10.0.1",
    "socks-proxy-agent": "8.0.5",
    "jsonparse": "1.3.1",
    "@antfu/utils": "9.3.0",
    "deepmerge": "4.3.1",
    "proc-log": [
      "5.0.0",
      "6.0.0"
    ],
    "lru-cache": "11.2.2",
    "hosted-git-info": "9.0.2",
    "validate-npm-package-name": "7.0.0",
    "npm-package-arg": "13.0.2",
    "p-map": "7.0.3",
    "@isaacs/balanced-match": "4.0.1",
    "path-scurry": "2.0.0",
    "glob": "11.0.3",
    "err-code": "2.0.3",
    "retry": "0.12.0",
    "promise-retry": "2.0.1"
  }
}
